# Copy to .env and fill in. .env is ignored by git.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Host port the app is published on
PORT=3000

# The address people use to reach the app (no trailing slash).
# Used for links in emails and as the OAuth redirect for Google / Microsoft.
PUBLIC_URL=https://boka.example.com

# Connect ONE calendar under Settings: Google or Microsoft 365. Configure either or both here.

# Google Calendar + Meet (optional). OAuth client of type "Web application" in Google Cloud
# Console, redirect URI: <PUBLIC_URL>/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft 365: Outlook calendar + Teams, and email from your mailbox (optional).
# App registration in Microsoft Entra admin center, Web redirect URI:
# <PUBLIC_URL>/api/calendar/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Your directory (tenant) ID, or "organizations" for any work/school account
MICROSOFT_TENANT_ID=

# Email notifications over SMTP (optional; not needed if you send via Microsoft 365).
# Port 465 uses TLS, 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cadence <bokning@example.com>"
